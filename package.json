{
  "name": "dsh-rpgmaker-mv",
  "version": "0.1.0",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "description": "Windows-first DeepSeek Harness launcher for RPG Maker MV projects",
  "private": true,
  "scripts": {
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "bootstrap": "bun run src/cli.ts bootstrap",
    "doctor": "bun run src/cli.ts doctor",
    "launch": "bun run src/cli.ts launch",
    "phase2:real": "bun run scripts/phase2-real-acceptance.ts",
    "phase4:real": "bun run scripts/phase4-real-acceptance.ts",
    "phase6:real": "bun run scripts/phase6-real-acceptance.ts",
    "phase8:real": "bun run scripts/phase8-real-acceptance.ts",
    "phase6:windows-manual": "bun run scripts/phase6-windows-manual-gate.ts",
    "phase7:real": "bun run scripts/phase7-real-acceptance.ts",
    "phase7:windows-installed": "bun run scripts/phase7-windows-installed-gate.ts",
    "release:zip": "bun run scripts/build-release-zip.ts"
  },
  "type": "module"
}
